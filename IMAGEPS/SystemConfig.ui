                 <property name="styleSheet">
                  <string notr="true">/* QGroupBox 圆角边框样式 */
QGroupBox {
    border: 1.5px solid #00a99d;   
    border-radius: 8px;           /* 8像素圆角 */
    margin-top: 1ex;              /* 留出标题空间 */
    padding: 10px;                /* 内边距 */
    font-weight: bold;            /* 标题加粗 */
}
 
/* QGroupBox 标题样式 */
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;                   /* 标题左边距 */
    padding: 0 5px;               /* 标题内边距 */
}</string>
