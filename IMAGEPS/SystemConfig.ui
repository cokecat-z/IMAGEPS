       <item>
        <layout class="QHBoxLayout" name="horizontalLayout">
         <item>
          <widget class="QPushButton" name="okButton">
           <property name="font">
            <font>
             <family>Source Han Sans SC Medium</family>
             <pointsize>9</pointsize>
             <weight>7</weight>
             <italic>false</italic>
             <bold>false</bold>
            </font>
           </property>
           <property name="styleSheet">
            <string notr="true">/* 通用按钮样式 - 圆角 */
QPushButton {
    background-color: #f0f0f0;     /* 默认背景色 */
    color: #333;                   /* 文字颜色 */
    border: 1px solid #ccc;        /* 边框 */
    border-radius: 6px;            /* 圆角半径 */
    padding: 6px 12px;             /* 内边距 */
    min-width: 60px;               /* 最小宽度 */
}
 
/* 悬停效果 - 浅色过渡 */
QPushButton:hover {
    background-color: #c0f0ef;     /* 悬停背景色 */
    border-color: #00a99d;         /* 边框变色 */
    border-radius: 6px;            /* 保持圆角 */
}
 
/* 按下/选中效果 - 主色 */
QPushButton:pressed,
QPushButton:checked {
    background-color: #00a99d;     /* 主背景色 */
    color: white;                  /* 文字变白 */
    border-color: #008080;         /* 深色边框 */
    border-radius: 6px;            /* 保持圆角 */
}
 
/* 禁用状态 - 灰色 */
QPushButton:disabled {
    background-color: #f0f0f0;
    color: #999;
    border: 1px solid #ddd;
    border-radius: 6px;
}
 
/* 渐变增强效果（可选） */
QPushButton:pressed {
    background: qradialgradient(
        cx: 0.5, cy: 0.5,
        fx: 0.5, fy: 0.5,
        radius: 1,
        stop: 0 #00a99d,
        stop: 1 #008080 
    );
}</string>
           </property>
           <property name="text">
            <string>执行</string>
           </property>
          </widget>
