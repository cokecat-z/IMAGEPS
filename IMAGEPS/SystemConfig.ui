/* QComboBox 圆角边框 */
QComboBox {
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 3px 6px;
    background: white;
    min-width: 6em;
}
 
QComboBox:hover {
    border-color: #00a99d;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 15px;
    border-left: 1px solid #d0d0d0;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f6f6f6, stop:1 #e0e0e0);
} 

QComboBox::down-arrow {
    image: url(:/resource/menu/下拉箭头.png);  /* 自定义箭头图标 */
    width: 10px;
    height: 10px;
}

/* QLineEdit 圆角边框 */
QLineEdit {
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px 6px;
    background: white;
    selection-background-color: #00a99d;
    selection-color: white;
}
 
QLineEdit:hover {
    border-color: #00a99d;
}
 
QLineEdit:focus {
    border: 1px solid #00a99d;
    outline: none;
}
 
/* QCheckBox 圆角边框 */
QCheckBox {
    spacing: 5px;
    font: inherit;
}
 
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    background: white;
}
 
QCheckBox::indicator:checked {
    image: url(:/resource/menu/方形勾选.png); 
}

QCheckBox::indicator:disabled {
    background: #f0f0f0;
    border: 1px solid #cccccc;
}</string>
