QDockWidget {
   color: #00a99d !important;
}
TabbedDockWidget {
   color: #00a99d !important;
}
 /* 保持原有的 QTableWidget 样式 */
QTableWidget {
    background-color: #f2f2f2;
    border: none;
    gridline-color: #d0d0d0;
}
 
/* 表头样式 - 带省略号效果 */
QHeaderView {
    border: none;
    margin: 0;
}
 
QHeaderView::section {
	background-color: #f2f2f2;
    color: #333;
    margin: 0;
    text-align: center;
    qproperty-alignment: AlignCenter;
    
    /* 省略号关键设置 */
    text-overflow: ellipsis;
    max-width: 50px;
    min-width: 5px;

    /* 添加阴影效果以增加立体感 */
    border-radius: 2px;
    box-shadow: 1px 1px 2px rgba(0, 0, 0, 0.1);
}

/* 强制表头在 selected/focus/active 状态下也不改变外观 */
QHeaderView::section:selected,
QHeaderView::section:focus,
QHeaderView::section:active {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #585858, stop:1 #585858);
    color: #333;
    border: 1px solid #585858; /* 添加边框 */
    outline: none;
 	box-shadow: 1px 1px 2px rgba(0, 0, 0, 0.1);
} 
 
QHeaderView::section:hover {
    background-color: #c0f0ef;
    qproperty-toolTip: attr(text);
}
 
QHeaderView::section:pressed {
    background-color: #00a99d;
    color: white;
}

QHeaderView::section:!selected {
    background-color: #f2f2f2;
    color: #333;
} 

/* 单元格设置 */
QTableWidget::item {
    border: 1px solid #d0d0d0;
    margin: 0;
    padding: 2px;
}
 
/* 选中单元格效果 */
QTableWidget::item:selected {
    background-color: #00a99d;
    color: white;
}
 
/* 交替行颜色 */
QTableWidget::item:alternate {
    background-color: #fafafa;
}

QMessageBox {
    min-width: 420px;  /* 最小宽度 */
    max-width: 600px;  /* 最大宽度 */
    padding: 10px;     /* 内边距 */
}
 
/* 按钮样式 */
QMessageBox QPushButton {
    min-width: 50px;   /* 按钮最小宽度 */
    min-height: 18px;  /* 按钮最小高度 */
    border: 1px solid #a0a0a0;  /* 边框 */
    border-radius: 3px;
    padding: 5px 10px;
    margin: 8px;       /* 按钮间距 */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f6f6f6, stop:1 #e0e0e0);
}
 
/* 按钮悬停效果 */
QMessageBox QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #e0e0e0, stop:1 #d0d0d0);
}
 
/* 按钮按下效果 */
QMessageBox QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #d0d0d0, stop:1 #c0c0c0);
}
 </string>
