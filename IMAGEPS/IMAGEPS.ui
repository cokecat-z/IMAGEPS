          <string notr="true">*{font: 400 9pt &quot;Source Han Sans SC Medium&quot;;}
QLabel {
    background: #f2f2f2;
}
QDockWidget {
    border: 1px solid #00a99d;
    border-radius: 4px;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;	
	font: inherit; /* 继承全局字体设置 */
}
QDockWidget::title {
	background: #f2f2f2;
    padding: 5px 10px;
    text-align: left;
    border-radius: 4px 4px 0 0;
	font: inherit;
	border-bottom: 1px solid #000000;
}
QDockWidget::close-button, QDockWidget::float-button {
    border: none;
    background: transparent;
    padding: 4px;
	font: inherit;
}
QDockWidget::close-button {
    subcontrol-position: top right;
    right: 5px;
    
    /* 强制固定尺寸 */
    width: 24px !important;
    height: 24px !important;
    min-width: 24px !important;
    min-height: 24px !important;
    max-width: 24px !important;
    max-height: 24px !important;
    
    /* 使用系统默认关闭图标并强制大小 */
    qproperty-icon: url(:/resource/menu/close.png); 
    qproperty-iconSize: 28px 28px;
    
    /* 确保按钮内容居中 */
    padding: 0px !important;
    margin: 0px !important;
}
 
QDockWidget::float-button {
    subcontrol-position: top right;
    right: 30px;
}
 
/* 增强悬停效果 */
QDockWidget::close-button:hover {
    background: rgba(255, 255, 255, 0.2);
}

QDockWidget &gt; QWidget {
    border: 1px solid #000000;
    border-top: none;
    border-radius: 0 0 4px 4px;
    padding: 4px;
}


TabbedDockWidget {
    border: 1px solid #00a99d;
    border-radius: 4px;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
	font: inherit;
}
TabbedDockWidget::title {
	background: #f2f2f2;
    padding: 5px 10px;
    text-align: left;
    border-radius: 4px 4px 0 0;
	font: inherit;
	border-bottom: 1px solid #000000;
	min-height: 30px;
}
TabbedDockWidget::close-button, TabbedDockWidget::float-button {
    border: none;
    background: transparent;
    padding: 4px;
}
TabbedDockWidget::close-button {
    subcontrol-position: top right;
    right: 5px;
    
    /* 强制固定尺寸 */
    width: 24px !important;
    height: 24px !important;
    min-width: 24px !important;
    min-height: 24px !important;
    max-width: 24px !important;
    max-height: 24px !important;
    
    /* 使用系统默认关闭图标并强制大小 */
    qproperty-icon: url(:/resource/menu/close.png); 
    qproperty-iconSize: 28px 28px;
    
    /* 确保按钮内容居中 */
    padding: 0px !important;
    margin: 0px !important;
}
 
TabbedDockWidget::float-button {
    subcontrol-position: top right;
    right: 30px;
}
 
/* 增强悬停效果 */
TabbedDockWidget::close-button:hover {
    background: rgba(255, 255, 255, 0.2);
}

TabbedDockWidget &gt; QWidget {
    border: 1px solid #000000;
    border-top: none;
    border-radius: 0 0 4px 4px;
    padding: 4px;
} 

QTableWidget {
    background-color: #f2f2f2;
    border: none;
    gridline-color: #d0d0d0;
}</string>
