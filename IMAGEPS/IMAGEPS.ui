                  <string notr="true"> /* 保持原有的 QTableWidget 样式 */
QTableView {
    background-color: #f2f2f2;
    border: none;
    gridline-color: #d0d0d0;
}
 
/* 表头样式 - 带省略号效果 */
QHeaderView {
    border: none;
    margin: 0;
}
 
QHeaderView::section {
	background-color: #f2f2f2;
    color: #333;
    margin: 0;
    text-align: center;
    qproperty-alignment: AlignCenter;
    
    /* 省略号关键设置 */
    text-overflow: ellipsis;
    max-width: 50px;
    min-width: 5px;

