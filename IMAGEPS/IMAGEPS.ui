                <property name="styleSheet">
                 <string notr="true">/* 主菜单栏样式 - 自适应宽度 */
QMenuBar {
    background-color: #defcfb;
    border: none;
    height: 20px; /* 适当增加高度以更好容纳图标 */
    spacing: 2px; /* 菜单项间距 */
    margin: 0;    /* 移除外边距 */
}
 
/* 取消固定宽度限制，允许自然扩展 */
QMenuBar::item {
    background: transparent;
    padding: 10px 6px; /* 调整内边距 */
    border-radius: 8px;
    color: #333333;
    min-width: 60px;   /* 设置最小宽度 */
    max-width: none;   /* 取消最大宽度限制 */
}
 
/* 悬停状态 */
QMenuBar::item:hover {
    background: #00a99d;
    color: white;
}
 
/* 带图标的菜单项对齐优化 */
QMenuBar::item:has-icon {
    padding-left: 8px;  /* 图标与文字间距 */
}
 
/* 下拉菜单样式保持原有 */
QMenu {
    background-color: #defcfb;
    border: 1px solid #00a99d;
    border-radius: 8px;
    margin: 2px; /* 下拉菜单与菜单栏的间距 */
}
 
QMenu::item {
    padding: 5px 25px 5px 15px;
    border-radius: 5px;
    color: #333;
}
 
QMenu::item:selected {
    background: #00a99d;
    color: white;
}
 
QMenu::separator {
    height: 1px;
    background: #c0c0c0;
    margin: 5px 0;
}</string>
