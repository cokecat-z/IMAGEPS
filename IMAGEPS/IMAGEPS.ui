   <property name="styleSheet">
    <string notr="true">*{font: 570 9pt &quot;Source Han Sans SC Medium&quot;;}
/* 主菜单栏样式 */
QMenuBar {
    background-color: #defcfb;
    border: none;
    min-width: 0px;
    max-width: 16777215px; /* Qt的最大宽度值 */
}
 
/* 菜单项基础样式 */
QMenuBar::item {
    background: transparent;
    padding: 10px 6px;
    border-radius: 8px;      /* 圆角半径 */
    color: #333333;          /* 默认文字颜色 */
    margin: 2px;             /* 项间距 */
}
 
/* 悬停状态 */
QMenuBar::item:hover {
    background: #00a99d;
    color: white;            /* 悬停文字白色 */
    border-radius: 8px;
}
 
/* 按下状态 */
QMenuBar::item:pressed {
    background: #00a99d;
    color: white;
    border-radius: 8px;
}

/* 下拉菜单样式 */
QMenu {
    background-color: #defcfb;
    border: 1px solid #00a99d;
    border-radius: 8px;
}
 
QMenu::item {
    padding: 5px 25px 5px 15px;
    border-radius: 5px;
    color: #333;
}
 
QMenu::item:selected {
    background: #00a99d;
    color: white;
}
 
QMenu::separator {
    height: 1px;
    background: #c0c0c0;
    margin: 5px 0;
}</string>
   </property>
